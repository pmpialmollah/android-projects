<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.SellFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:padding="10dp"
        android:text="Sell Product"
        android:textColor="@color/dark_coffee"
        android:textSize="30sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/selectCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/card_background"
        android:gravity="center_horizontal"
        android:padding="10dp"
        android:text="select customer"
        android:textColor="@color/dark_coffee"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sellProductRecyclerView"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:background="@drawable/card_background"
            android:padding="5dp" />

        <ImageView
            android:id="@+id/addProduct"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:background="@drawable/card_background"
            android:backgroundTint="@color/dark_coffee"
            android:padding="7dp"
            android:src="@drawable/add"
            android:text="+"
            app:tint="@color/white" />
    </LinearLayout>


    <TextView
        android:id="@+id/totalPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/card_background"
        android:gravity="center_horizontal"
        android:padding="10dp"
        android:text="Total: 1200"
        android:textColor="@color/dark_coffee"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/paidEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/card_background"
            android:inputType="numberDecimal"
            android:padding="10dp"
            android:hint="paid"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/totalDue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/card_background"
            android:padding="10dp"
            android:text="due: 0.0"
            android:textColor="@color/black"
            android:textSize="18sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/sellProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp"
        android:background="@drawable/card_background"
        android:backgroundTint="@color/dark_coffee"
        android:paddingHorizontal="70dp"
        android:paddingVertical="10dp"
        android:text="Sell"
        android:textColor="@color/white"
        android:textSize="22sp" />

</LinearLayout>