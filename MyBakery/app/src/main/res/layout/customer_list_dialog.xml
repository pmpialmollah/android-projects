<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/light"
    app:cardCornerRadius="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/productPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="10dp"
            android:text="Select customer"
            android:textColor="@color/dark_coffee"
            android:textSize="25sp"
            android:textStyle="bold" />


        <EditText
            android:id="@+id/dialogCustomerSearchEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="5dp"
            android:background="@drawable/card_background"
            android:hint="Search"
            android:padding="5dp"
            android:textColor="@color/dark_coffee"
            android:textColorHint="@color/light_coffee" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialogCustomerRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:scrollbarThumbVertical="@drawable/scrollbar_thump"
            android:scrollbars="vertical" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
